<!-- Inline interaction logic without styles/comments -->
<script>
    function setPreset(val) {
      const input = document.getElementById('coupon-input');
      if (input) {
        input.value = val;
        input.focus();
      }
    }

    const flashBtn = document.getElementById('toggle-flash');
    if (flashBtn) {
      flashBtn.addEventListener('click', function() {
        this.classList.toggle('bg-primary-container');
        this.classList.toggle('text-on-primary-container');
      });
    }

    const camBtn = document.getElementById('toggle-cam');
    if (camBtn) {
      camBtn.addEventListener('click', function() {
        this.classList.toggle('rotate-180');
      });
    }

    const scanForm = document.getElementById('scan-form');
    if (scanForm) {
      scanForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const input = document.getElementById('coupon-input');
        if (!input) return;
        const val = input.value.trim().toUpperCase();
        if (val === 'ABSC-0042') {
          alert('Peringatan: Kupon ABSC-0042 sudah pernah di-scan pada 08:30 WIB!');
        } else {
          alert('Berhasil: Kupon ' + val + ' valid dan status kehadiran tersimpan!');

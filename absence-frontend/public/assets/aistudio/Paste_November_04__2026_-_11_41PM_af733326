<script>
  let currentStatusFilter = 'ALL';
  let currentClassFilter = 'ALL';
  let searchQuery = '';
  let pendingDeleteId = null;

  function filterStatus(status, element) {
    currentStatusFilter = status;
    document.querySelectorAll('.status-filter-tab').forEach(tab => {
      tab.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-sm');
      tab.classList.add('text-text-muted');
    });
    element.classList.remove('text-text-muted');
    element.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-sm');
    applyFilters();
  }

  function filterClass(className) {
    currentClassFilter = className;
    applyFilters();
  }

  function handleSearch(val) {
    searchQuery = val.trim().toLowerCase();
    const clearBtn = document.getElementById('clearSearchBtn');
    if (searchQuery.length > 0) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }
    applyFilters();
  }

  function clearSearch() {
    const input = document.getElementById('searchInput');
    input.value = '';
    searchQuery = '';
    document.getElementById('clearSearchBtn').classList.add('hidden');
    applyFilters();
  }

  function applyFilters() {
    const rows = document.querySelectorAll('.participant-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const rowStatus = row.getAttribute('data-status');
      const rowClass = row.getAttribute('data-class');
      const rowText = row.innerText.toLowerCase();

      const matchesStatus = (currentStatusFilter === 'ALL') || (rowStatus === currentStatusFilter);
      const matchesClass = (currentClassFilter === 'ALL') || (rowClass === currentClassFilter);
      const matchesSearch = (searchQuery === '') || rowText.includes(searchQuery);

      if (matchesStatus && matchesClass && matchesSearch) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const emptyState = document.getElementById('tableEmptyState');
    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
    } else {
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
    }
  }

  function resetFilters() {
    clearSearch();
    document.getElementById('classFilterSelect').value = 'ALL';
    currentClassFilter = 'ALL';
    const allTab = document.querySelectorAll('.status-filter-tab')[0];
    if (allTab) {
      filterStatus('ALL', allTab);
    } else {
      applyFilters();
    }
  }

  function copyCode(code) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(code).then(() => {
        showToast('Kupon ' + code + ' disalin ke clipboard!');
      }).catch(() => {
        showToast('Kupon ' + code + ' disalin!');
      });
    } else {
      showToast('Kupon ' + code + ' disalin!');
    }
  }

  function quickRedeem(id, name) {
    const row = document.querySelector(`.participant-row[data-id="${id}"]`);
    if (!row) return;

    // Mutate state to Redeemed
    row.setAttribute('data-status', 'REDEEMED');
    
    // Update status cell (column 7)
    const statusCell = row.children[6];
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    
    statusCell.innerHTML = `
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-fixed font-label-badge text-label-badge animate-fade-in">
        <span class="material-symbols-outlined text-[16px] text-secondary">check_circle</span>
        <span>Hadir - ${hours}:${minutes} WIB</span>
      </div>
    `;

    // Disable Quick redeem button
    const actionCell = row.children[7];
    const redeemBtn = actionCell.querySelector('button[title*="Quick Redeem"]');
    if (redeemBtn) {
      redeemBtn.outerHTML = `
        <button disabled class="w-9 h-9 rounded-lg bg-surface-container text-text-muted/40 cursor-not-allowed flex items-center justify-center" title="Sudah divalidasi">
          <span class="material-symbols-outlined text-[18px]">verified</span>
        </button>
      `;
    }

    // Update KPI numbers
    const kpiHadir = document.getElementById('kpiHadir');
    const kpiBelum = document.getElementById('kpiBelum');
    if (kpiHadir && kpiBelum) {
      kpiHadir.innerText = parseInt(kpiHadir.innerText) + 1;
      kpiBelum.innerText = Math.max(0, parseInt(kpiBelum.innerText) - 1);
    }

    showToast(`Presensi berhasil diverifikasi untuk ${name}!`);
    applyFilters();
  }

  function openDeleteModal(id, desc) {
    pendingDeleteId = id;
    document.getElementById('deleteConfirmText').innerText = `Anda yakin ingin menghapus data "${desc}"? Tindakan ini tidak dapat dibatalkan.`;
    const modal = document.getElementById('deleteModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeDeleteModal() {
    pendingDeleteId = null;
    const modal = document.getElementById('deleteModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function confirmDeleteAction() {
    if (!pendingDeleteId) return;
    const row = document.querySelector(`.participant-row[data-id="${pendingDeleteId}"]`);
    if (row) {
      row.remove();
      const kpiTotal = document.getElementById('kpiTotal');
      if (kpiTotal) {
        kpiTotal.innerText = Math.max(0, parseInt(kpiTotal.innerText) - 1);
      }
      showToast('Data peserta berhasil dihapus dari sistem.');
    }
    closeDeleteModal();
    applyFilters();
  }

  function showToast(msg) {
    const toast = document.getElementById('actionToast');
    const msgEl = document.getElementById('toastMessage');
    msgEl.innerText = msg;

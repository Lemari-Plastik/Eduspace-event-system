<script>
  // Filter Tabs Interaction
  const tabs = document.querySelectorAll('.status-tab');
  const rows = document.querySelectorAll('.log-row');
  const searchInput = document.getElementById('search-input');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm', 'font-semibold');
        t.classList.add('text-text-muted');
      });
      tab.classList.remove('text-text-muted');
      tab.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm', 'font-semibold');

      const filter = tab.getAttribute('data-filter');
      filterRows(filter, searchInput.value.toLowerCase());
    });
  });

  // Client-side text search filter
  searchInput.addEventListener('input', (e) => {
    const activeTab = document.querySelector('.status-tab.font-semibold');
    const filter = activeTab ? activeTab.getAttribute('data-filter') : 'all';
    filterRows(filter, e.target.value.toLowerCase());
  });

  function filterRows(statusFilter, query) {
    rows.forEach(row => {
      const rowStatus = row.getAttribute('data-status');
      const text = row.innerText.toLowerCase();
      
      const matchesStatus = (statusFilter === 'all') || (rowStatus === statusFilter);
      const matchesQuery = query === '' || text.includes(query);

      if (matchesStatus && matchesQuery) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  // Refresh feed micro-interaction with toast prompt
  const refreshBtn = document.getElementById('toggle-live-feed');
  const refreshIcon = document.getElementById('refresh-icon');
  const toast = document.getElementById('toast-live');

  refreshBtn.addEventListener('click', () => {
    refreshIcon.classList.add('animate-spin');
    setTimeout(() => {
      refreshIcon.classList.remove('animate-spin');
      toast.classList.remove('opacity-0', 'translate-y-24');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-24');
      }, 3500);
    }, 600);
  });

  // Export CSV mock trigger
  document.getElementById('btn-export-log').addEventListener('click', () => {
    const btn = document.getElementById('btn-export-log');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin text-primary">progress_activity</span><span>Mengekspor...</span>';
    setTimeout(() => {
      btn.innerHTML = originalText;
    }, 1200);
  });
</script></main></div>


